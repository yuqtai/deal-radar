# 复制为 .env 后按需填写：cp .env.example .env
# 全部可选——什么都不填也能跑（抓取 + 页面浏览），填了才开启对应功能。
# .env 已在 .gitignore 中，切勿把真实 Key 提交到仓库。

# ---------- 微信推送（息知，免费） ----------
# 获取：微信关注公众号「息知」→ 底部「消息推送」，或 https://xz.qqoq.net/ 扫码登录后在「我的」页面查看
# 只填 Key 本身（XZ 开头），不要填整个 https://xizhi.qqoq.net/xxx.send 地址
XIZHI_KEY=

# ---------- AI 价值评分 / 分类 / 排行榜（OpenRouter，免费模型） ----------
# 获取：https://openrouter.ai/keys 创建 Key（sk-or-v1- 开头）
OPENROUTER_API_KEY=
# 模型：任意 OpenRouter 对话模型，默认免费的 ERNIE，失败自动换备用；一般不用改
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

# ---------- 通用决策接口（System One / Jev 格式，优先使用） ----------
# POST 完整接口地址，发送 { model, state, questions }，返回 { answers }
# 支持任意兼容服务；不配置时默认使用 OpenRouter 的免费 Decider
DECISION_ENDPOINT=https://openrouter.ai/api/alpha/decisions
DECISION_MODEL=perplexity/pplx-decider-v1.3:free
# 接口是 OpenRouter 时可留空，自动复用 OPENROUTER_API_KEY；其他服务填各自的 Key
DECISION_API_KEY=
# TypeSafe 示例：DECISION_ENDPOINT=https://api.typesafe.ai/v1/systemone
#               DECISION_MODEL=jev-latest，DECISION_API_KEY=你的 TypeSafe Key
# 旧的 TYPESAFE_API_KEY / TYPESAFE_MODEL 仍兼容；新配置优先。

# ---------- 运行参数 ----------
PORT=3000
# 数据目录（SQLite 文件位置）
DATA_DIR=./data
# 自动刷新间隔（分钟），0 = 关闭
REFRESH_INTERVAL_MINUTES=120
# 推送静默时段（北京时间，起-止），off = 关闭
PUSH_QUIET_HOURS=23-8
# Jina Reader Key（可选）：LINUX DO 显示异常 / HTTP 429 时配置，免费申请 https://jina.ai/reader
JINA_API_KEY=
